{
  "manifest_version": 3,
  "name": "DeveloperX",
  "version": "2.3.0",
  "description": "DeveloperX — managed Google Flow access with live credit tracking, sticky session, model auto-lock, a floating usage overlay, and Story Mode batch generation.",
  "permissions": [
    "cookies",
    "tabs",
    "storage",
    "activeTab",
    "scripting",
    "management",
    "browsingData",
    "alarms",
    "proxy",
    "downloads"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://*.labs.google/*",
    "https://*.lovable.dev/*",
    "https://*.lovable.app/*",
    "https://*.google.com/*",
    "https://accounts.google.com/*",
    "https://*.youtube.com/*",
    "https://flow.google/*",
    "https://*.flow.google/*",
    "https://raw.githubusercontent.com/*",
    "https://api.ipify.org/*"
  ],
  "background": {
    "service_worker": "bridge_background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/fx/*tools/flow*",
        "https://labs.google/*/fx/*tools/flow*",
        "https://flow.google/*",
        "https://*.flow.google/*"
      ],
      "js": [
        "ext_watchdog_iso.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://labs.google/fx/*tools/flow*",
        "https://labs.google/*/fx/*tools/flow*",
        "https://flow.google/*",
        "https://*.flow.google/*"
      ],
      "js": [
        "model_lock.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://labs.google/fx/*tools/flow*",
        "https://labs.google/*/fx/*tools/flow*",
        "https://flow.google/*",
        "https://*.flow.google/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://labs.google/fx/*tools/flow*",
        "https://labs.google/*/fx/*tools/flow*",
        "https://flow.google/*",
        "https://*.flow.google/*"
      ],
      "js": [
        "flow_overlay.js",
        "prompt_clear.js",
        "auto_retry.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.lovable.dev/*",
        "https://*.lovable.app/*"
      ],
      "js": [
        "site_bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "logo.png",
        "icon128.png"
      ],
      "matches": [
        "https://labs.google/*",
        "https://flow.google/*",
        "https://*.flow.google/*"
      ]
    }
  ]
}