{
  "manifest_version": 3,
  "name": "DeveloperX",
  "version": "1.1.1",
  "description": "DeveloperX \u2014 managed Google Flow access with live credit tracking, sticky session, model auto-lock, and a floating usage overlay.",
  "permissions": [
    "cookies",
    "tabs",
    "storage",
    "activeTab",
    "scripting",
    "management",
    "browsingData",
    "alarms"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://*.labs.google/*",
    "https://*.lovable.dev/*",
    "https://*.lovable.app/*",
    "https://*.google.com/*",
    "https://accounts.google.com/*",
    "https://*.youtube.com/*",
    "https://flow.google/*",
    "https://*.flow.google/*"
  ],
  "background": {
    "service_worker": "bridge_background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/*api/auth/signout*",
        "https://*.labs.google/*api/auth/signout*"
      ],
      "js": [
        "persistent_lock.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://labs.google/*",
        "https://*.labs.google/*",
        "https://flow.google/*",
        "https://*.flow.google/*"
      ],
      "js": [
        "ext_watchdog_main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://labs.google/*",
        "https://*.labs.google/*",
        "https://flow.google/*",
        "https://*.flow.google/*"
      ],
      "js": [
        "ext_watchdog_iso.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://labs.google/*",
        "https://*.labs.google/*",
        "https://flow.google/*",
        "https://*.flow.google/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://labs.google/*",
        "https://*.labs.google/*",
        "https://flow.google/*",
        "https://*.flow.google/*"
      ],
      "js": [
        "flow_overlay.js",
        "model_lock.js",
        "prompt_clear.js",
        "auto_retry.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://labs.google/*api/auth/signout*",
        "https://*.labs.google/*api/auth/signout*"
      ],
      "js": [
        "auto_signout.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://labs.google/*api/auth/signout*",
        "https://*.labs.google/*api/auth/signout*"
      ],
      "js": [
        "auto_signout.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.lovable.dev/*",
        "https://*.lovable.app/*"
      ],
      "js": [
        "site_bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "logo.png",
        "icon128.png"
      ],
      "matches": [
        "https://labs.google/*",
        "https://flow.google/*",
        "https://*.flow.google/*"
      ]
    }
  ]
}